# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Next.js build output & caches ────────────────────────────
.next/
out/
build/
.vercel/

# ── Next.js cache (standalone tracing) ───────────────────────
.cache/

# ── Production / debug logs ──────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── Environment variables (secrets — never commit) ───────────
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── OS metadata ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor / IDE ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Misc tooling caches ──────────────────────────────────────
.eslintcache
.stylelintcache
*.tsbuildinfo

# ── Three.js / WebGL local caches & temp ─────────────────────
